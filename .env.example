# Copy this file to .env and edit. Every setting is optional.

# Port for the device simulator website
PORT=3000

# ---- Base and Pro (on-device models) ----
# "python"  = model_server/server.py loading model.safetensors from models/base and models/pro (default)
# "openai"  = any OpenAI-compatible server, e.g. llama.cpp's llama-server running a GGUF
# "mock"    = built-in demo data, no model needed
LOCAL_BACKEND=python
PYTHON_MODEL_URL=http://127.0.0.1:8008

# Only used when LOCAL_BACKEND=openai
OPENAI_COMPAT_URL_BASE=http://127.0.0.1:8080
OPENAI_COMPAT_URL_PRO=http://127.0.0.1:8081

# ---- Lite (online, daily limit) ----
# With a key, Lite calls Gemma 4 through the Gemini API.
# Without a key, Lite is simulated: it uses the local model but still behaves like
# an online device (needs the network toggle on, counts data, has a daily limit).
GEMINI_API_KEY=
LITE_MODEL=gemma-4-31b-it
LITE_DAILY_LIMIT=40

# Force demo data for every tier (same as `npm run demo` or adding ?demo=1 to the URL)
DEMO=false
